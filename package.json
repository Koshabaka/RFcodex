{
  "name": "rf-codes",
  "version": "0.1.0",
  "private": true,
  "description": "Offline reference for Russian Federation codes on React Native",
  "scripts": {
    "start": "react-native start --reset-cache",
    "android:offline": "node scripts/offline-build-android.js",
    "ios:offline": "node scripts/offline-build-ios.js",
    "data:build": "ts-node --project tsconfig.scripts.json scripts/build-data.ts",
    "test": "jest"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.75.0"
  },
  "devDependencies": {
    "@babel/core": "7.24.0",
    "@babel/runtime": "7.24.0",
    "@react-native/babel-preset": "0.75.0",
    "@react-native/metro-config": "0.75.0",
    "@types/jest": "29.5.11",
    "@types/react": "18.2.69",
    "@types/react-native": "0.75.4",
    "@types/react-test-renderer": "18.0.0",
    "babel-jest": "29.7.0",
    "jest": "29.7.0",
    "metro-config": "0.80.6",
    "react-test-renderer": "18.2.0",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "react-native",
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.test.(ts|tsx)"
    ]
  }
}
