  "documents": {
    "gk-part1-1": {
      "id": "gk-part1-1",
      "codeId": "gk",
      "articleId": "gk-part1-1",
      "title": "Основные начала гражданского законодательства",
      "number": "1",
      "breadcrumbs": [
        "ГК РФ",
        "Часть I",
        "Глава 1"
      ],
      "text": "Гражданское законодательство основывается на признании равенства участников, неприкосновенности собственности, свободе договора, недопустимости произвольного вмешательства кого-либо в частные дела."
    },
    "gk-part1-2": {
      "id": "gk-part1-2",
      "codeId": "gk",
      "articleId": "gk-part1-2",
      "title": "Отношения, регулируемые гражданским законодательством",
      "number": "2",
      "breadcrumbs": [
        "ГК РФ",
        "Часть I",
        "Глава 1"
      ],
      "text": "Гражданское законодательство регулирует имущественные и связанные с ними личные неимущественные отношения, основанные на равенстве, автономии воли и имущественной самостоятельности участников."
    },
    "uk-general-14": {
      "id": "uk-general-14",
      "codeId": "uk",
      "articleId": "uk-general-14",
      "title": "Понятие преступления",
      "number": "14",
      "breadcrumbs": [
        "УК РФ",
        "Раздел I",
        "Глава 3"
      ],
      "text": "Преступлением признается виновно совершенное общественно опасное деяние, запрещенное настоящим Кодексом под угрозой наказания."
    },
    "uk-general-15": {
      "id": "uk-general-15",
      "codeId": "uk",
      "articleId": "uk-general-15",
      "title": "Категории преступлений",
      "number": "15",
      "breadcrumbs": [
        "УК РФ",
        "Раздел I",
        "Глава 3"
      ],
      "text": "Все преступления по характеру и степени общественной опасности подразделяются на преступления небольшой тяжести, средней тяжести, тяжкие и особо тяжкие."
    }
  },
